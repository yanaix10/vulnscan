<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VulnScan Security Report - {{ target }}</title>
    <!-- Geist and Geist Mono Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #09090b;
            --bg-card: #121215;
            --bg-code: #0c0d12;
            --border-color: #27272a;
            --text-main: #f4f4f5;
            --text-muted: #a1a1aa;
            --brand-primary: #6366f1;
            
            /* Severity Colors */
            --crit-color: #dc2626;
            --high-color: #ea580c;
            --med-color: #d97706;
            --low-color: #3b82f6;
            --info-color: #64748b;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Geist', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-main);
            line-height: 1.6;
            padding: 40px 24px;
        }
        .container { max-width: 1100px; margin: 0 auto; }
        
        /* Header */
        .header {
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 24px;
            margin-bottom: 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }
        .header h1 {
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .header h1 span {
            color: var(--brand-primary);
            font-family: 'Geist Mono', monospace;
            font-size: 13px;
            font-weight: 700;
            background: rgba(99, 102, 241, 0.12);
            border: 1px solid rgba(99, 102, 241, 0.3);
            padding: 3px 8px;
            border-radius: 6px;
        }
        
        /* Summary Grid */
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 14px;
            margin-bottom: 36px;
        }
        .summary-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 18px;
        }
        .summary-card .label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-muted);
            font-weight: 600;
            font-family: 'Geist Mono', monospace;
        }
        .summary-card .value {
            font-size: 22px;
            font-weight: 700;
            color: #fff;
            margin-top: 4px;
            font-family: 'Geist Mono', monospace;
        }
        
        /* Severity Badges */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            font-family: 'Geist Mono', monospace;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            shrink-0: 0;
        }
        .badge-critical { background: rgba(220, 38, 38, 0.15); color: var(--crit-color); border: 1px solid rgba(220, 38, 38, 0.4); }
        .badge-high { background: rgba(234, 88, 12, 0.15); color: var(--high-color); border: 1px solid rgba(234, 88, 12, 0.4); }
        .badge-medium { background: rgba(217, 119, 6, 0.15); color: var(--med-color); border: 1px solid rgba(217, 119, 6, 0.4); }
        .badge-low { background: rgba(59, 130, 246, 0.15); color: var(--low-color); border: 1px solid rgba(59, 130, 246, 0.4); }
        .badge-info { background: rgba(100, 116, 139, 0.15); color: var(--info-color); border: 1px solid rgba(100, 116, 139, 0.4); }

        /* Finding Card */
        .finding-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 22px;
            position: relative;
        }

        /* Finding Header Hierarchy */
        .finding-header {
            margin-bottom: 18px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            padding-bottom: 14px;
        }
        .finding-line-1 {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .finding-title-group {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .finding-title {
            font-size: 19px;
            font-weight: 700;
            color: #fff;
            letter-spacing: -0.2px;
        }
        .finding-cvss {
            font-family: 'Geist Mono', monospace;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            padding: 3px 8px;
            border-radius: 6px;
        }
        .finding-line-2 {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 6px;
            font-family: 'Geist', sans-serif;
            font-weight: 400;
        }

        /* Labeled Field Layout (label above value) */
        .labeled-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 14px;
            margin-bottom: 18px;
        }
        .field-item {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            padding: 10px 14px;
        }
        .field-label {
            display: block;
            font-size: 11px;
            font-family: 'Geist Mono', monospace;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-muted);
            margin-bottom: 4px;
        }
        .field-value {
            font-size: 13px;
            color: #e4e4e7;
            word-break: break-all;
        }
        .field-value.param-val {
            color: #f59e0b;
            font-family: 'Geist Mono', monospace;
            font-weight: 600;
        }
        .field-value a {
            color: var(--brand-primary);
            text-decoration: none;
            font-family: 'Geist Mono', monospace;
        }
        .field-value a:hover {
            text-decoration: underline;
        }

        /* Evidence & Code Blocks with Severity Left Border */
        .section-title {
            font-size: 11px;
            font-family: 'Geist Mono', monospace;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: var(--text-muted);
            margin: 16px 0 8px 0;
        }
        .code-box {
            background: var(--bg-code);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 16px 20px;
            font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 12px;
            color: #d4d4d8;
            overflow-x: auto;
            line-height: 1.6;
        }
        .code-box.critical-border { border-left: 4px solid var(--crit-color); }
        .code-box.high-border { border-left: 4px solid var(--high-color); }
        .code-box.medium-border { border-left: 4px solid var(--med-color); }
        .code-box.low-border { border-left: 4px solid var(--low-color); }
        .code-box.info-border { border-left: 4px solid var(--info-color); }

        .code-box pre {
            margin: 0;
            font-family: inherit;
            white-space: pre-wrap;
            word-break: break-all;
        }
        .code-box code {
            font-family: inherit;
            color: inherit;
        }

        .section-body {
            font-size: 13px;
            color: #d4d4d8;
            line-height: 1.6;
            margin: 4px 0 16px 0;
        }

        .accordion-item {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            margin-bottom: 12px;
            overflow: hidden;
        }
        .accordion-summary {
            padding: 16px 20px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            list-style: none;
            user-select: none;
        }
        .accordion-summary::-webkit-details-marker { display: none; }
        .accordion-summary:hover {
            background: rgba(255, 255, 255, 0.02);
        }
        .accordion-content {
            padding: 4px 20px 20px 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
        }

        .affected-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 8px;
            padding: 8px 12px;
            font-family: 'Geist Mono', monospace;
            font-size: 12px;
            gap: 10px;
            flex-wrap: wrap;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <div>
            <h1>VulnScan Security Report <span>DAST AUDIT</span></h1>
            <p style="color: var(--text-muted); font-size: 13px; margin-top: 4px;">Dynamic Application Security Assessment Report</p>
        </div>
        <div style="font-family: 'Geist Mono', monospace; font-size: 12px; color: var(--text-muted); text-align: right;">
            <div>Target: <strong style="color: #fff;">{{ target }}</strong></div>
            <div>Date: {{ timestamp[:19].replace('T', ' ') }} UTC</div>
        </div>
    </div>

    <!-- Executive Summary -->
    <div class="summary-grid">
        <div class="summary-card">
            <div class="label">Audited Target</div>
            <div class="value" style="font-size: 15px; word-break: break-all;">{{ target }}</div>
        </div>
        <div class="summary-card">
            <div class="label">Total Vulnerabilities</div>
            <div class="value" style="color: var(--brand-primary);">{{ total_findings }}</div>
        </div>
        <div class="summary-card">
            <div class="label">Critical Issues</div>
            <div class="value" style="color: var(--crit-color);">{{ severity_counts.critical }}</div>
        </div>
        <div class="summary-card">
            <div class="label">High Issues</div>
            <div class="value" style="color: var(--high-color);">{{ severity_counts.high }}</div>
        </div>
        <div class="summary-card">
            <div class="label">Medium Issues</div>
            <div class="value" style="color: var(--med-color);">{{ severity_counts.medium }}</div>
        </div>
        <div class="summary-card">
            <div class="label">Low / Info Issues</div>
            <div class="value" style="color: var(--low-color);">{{ severity_counts.low + severity_counts.info }}</div>
        </div>
    </div>

    <!-- Findings by Severity -->
    {% for severity in ['critical', 'high', 'medium', 'low', 'info'] %}
        {% set items = grouped_findings.get(severity, []) %}
        {% if items %}
            <h2 style="font-size: 18px; font-weight: 700; margin: 32px 0 16px 0; color: #fff; text-transform: uppercase; letter-spacing: 0.5px; font-family: 'Geist Mono', monospace;">
                {{ severity }} Severity ({{ items|length }} check{% if items|length != 1 %}s{% endif %})
            </h2>

            {% for check in items %}
                {% if severity in ['critical', 'high'] %}
                    <!-- Critical & High: Fully Expanded Cards -->
                    <div class="finding-card {{ severity }}">
                        <div class="finding-header">
                            <div class="finding-line-1">
                                <div class="finding-title-group">
                                    <span class="badge badge-{{ severity }}">{{ severity|upper }}</span>
                                    <span class="finding-title">{{ check.name }}</span>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="font-family: 'Geist Mono', monospace; font-size: 11px; background: rgba(255,255,255,0.06); padding: 3px 8px; border-radius: 6px; color: var(--text-muted);">
                                        {{ check.affected|length }} endpoint{% if check.affected|length != 1 %}s{% endif %} affected
                                    </span>
                                    <div class="finding-cvss">
                                        {{ check.cvss.split(' ')[0] }} CVSS
                                    </div>
                                </div>
                            </div>
                            <div class="finding-line-2">
                                {{ check.owasp_category }} · {{ check.cwe_id.split(':')[0] }}
                            </div>
                        </div>

                        <!-- Reduced box-on-box nesting: heading + plain text with normal padding -->
                        <div class="section-title">Threat Impact & Attack Vector</div>
                        <p class="section-body">{{ check.impact }}</p>

                        <!-- Remediation Guidance: No duplicate inline 'Remediation:' prefix -->
                        <div class="section-title">Remediation Guidance</div>
                        <p class="section-body">{{ check.remediation }}</p>

                        <!-- Quoted Technical Content: Secure Code Reference (with left border) -->
                        {% if check.code_examples %}
                            <div class="section-title">Secure Code Implementation Reference</div>
                            {% for lang, code in check.code_examples.items() %}
                                <div class="code-box {{ severity }}-border" style="margin-top: 8px;">
                                    <div style="color: var(--brand-primary); font-weight: 700; text-transform: uppercase; font-size: 11px; margin-bottom: 6px;">// {{ lang }} implementation:</div>
                                    <pre><code class="language-{{ lang }}">{{ code|escape }}</code></pre>
                                </div>
                            {% endfor %}
                        {% endif %}

                        <!-- Quoted Technical Content: Technical Evidence (with left border) -->
                        {% if check.affected[0].evidence %}
                            <div class="section-title">Technical Evidence & Proof-of-Concept Sample</div>
                            <div class="code-box {{ severity }}-border">
                                <pre><code>{{ check.affected[0].evidence|escape }}</code></pre>
                            </div>
                        {% endif %}

                        <!-- Compact List of Every Affected Endpoint (URL + parameter, one line each) -->
                        <div class="section-title" style="margin-top: 20px;">Affected Endpoints ({{ check.affected|length }})</div>
                        <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px;">
                            {% for aff in check.affected %}
                                <div class="affected-item">
                                    <a href="{{ aff.url }}" target="_blank" style="color: var(--brand-primary); text-decoration: none; word-break: break-all;">
                                        {{ aff.url }}
                                    </a>
                                    {% if aff.parameter %}
                                        <span style="color: #f59e0b; font-weight: 600;">Param: {{ aff.parameter }}</span>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% else %}
                    <!-- Medium, Low, Info: Collapsible Accordion Items -->
                    <details class="accordion-item">
                        <summary class="accordion-summary">
                            <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                                <span class="badge badge-{{ severity }}">{{ severity|upper }}</span>
                                <strong style="font-size: 15px; color: #fff;">{{ check.name }}</strong>
                            </div>
                            <div style="display: flex; align-items: center; gap: 12px; font-family: 'Geist Mono', monospace; font-size: 12px; color: var(--text-muted);">
                                <span style="background: rgba(255,255,255,0.06); padding: 3px 8px; border-radius: 6px; color: #fff;">
                                    {{ check.affected|length }} endpoint{% if check.affected|length != 1 %}s{% endif %} affected
                                </span>
                                <span>{{ check.cvss.split(' ')[0] }} CVSS</span>
                            </div>
                        </summary>
                        <div class="accordion-content">
                            <div style="font-size: 13px; color: var(--text-muted); margin: 12px 0 16px 0;">
                                {{ check.owasp_category }} · {{ check.cwe_id.split(':')[0] }}
                            </div>

                            <!-- Reduced box-on-box nesting: heading + plain text with normal padding -->
                            <div class="section-title">Threat Impact & Attack Vector</div>
                            <p class="section-body">{{ check.impact }}</p>

                            <!-- Remediation Guidance: No duplicate inline 'Remediation:' prefix -->
                            <div class="section-title">Remediation Guidance</div>
                            <p class="section-body">{{ check.remediation }}</p>

                            <!-- Quoted Technical Content: Secure Code Reference (with left border) -->
                            {% if check.code_examples %}
                                <div class="section-title">Secure Code Implementation Reference</div>
                                {% for lang, code in check.code_examples.items() %}
                                    <div class="code-box {{ severity }}-border" style="margin-top: 8px;">
                                        <div style="color: var(--brand-primary); font-weight: 700; text-transform: uppercase; font-size: 11px; margin-bottom: 6px;">// {{ lang }} implementation:</div>
                                        <pre><code class="language-{{ lang }}">{{ code|escape }}</code></pre>
                                    </div>
                                {% endfor %}
                            {% endif %}

                            <!-- Quoted Technical Content: Technical Evidence (with left border) -->
                            {% if check.affected[0].evidence %}
                                <div class="section-title">Technical Evidence & Proof-of-Concept Sample</div>
                                <div class="code-box {{ severity }}-border">
                                    <pre><code>{{ check.affected[0].evidence|escape }}</code></pre>
                                </div>
                            {% endif %}

                            <!-- Compact List of Every Affected Endpoint (URL + parameter, one line each) -->
                            <div class="section-title" style="margin-top: 20px;">Affected Endpoints ({{ check.affected|length }})</div>
                            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px; max-height: 280px; overflow-y: auto;">
                                {% for aff in check.affected %}
                                    <div class="affected-item">
                                        <a href="{{ aff.url }}" target="_blank" style="color: var(--brand-primary); text-decoration: none; word-break: break-all;">
                                            {{ aff.url }}
                                        </a>
                                        {% if aff.parameter %}
                                            <span style="color: #f59e0b; font-weight: 600;">Param: {{ aff.parameter }}</span>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </details>
                {% endif %}
            {% endfor %}
        {% endif %}
    {% endfor %}

    {% if total_findings == 0 %}
        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 40px; text-align: center; color: var(--text-muted);">
            <h3>No security vulnerabilities detected.</h3>
            <p style="margin-top: 8px;">Target endpoint respected configured security parameters during the audit.</p>
        </div>
    {% endif %}
</div>
</body>
</html>
